#!/bin/sh

set -u
umask 077

CCS_VERSION=0.8.0

# An empty HOME would make the HOME-derived defaults collapse to filesystem-root
# paths (/.config/ccs, /.claude/settings.json). set -u catches an *unset* HOME
# but not an empty one, so guard explicitly unless the path is fully overridden.
if [ -z "${CCS_DIR:-}" ] && [ -z "${HOME:-}" ]; then
    printf 'Error: HOME is empty; set HOME or CCS_DIR\n' >&2
    exit 1
fi
if [ -z "${CLAUDE_SETTINGS_FILE:-}" ] && [ -z "${HOME:-}" ]; then
    printf 'Error: HOME is empty; set HOME or CLAUDE_SETTINGS_FILE\n' >&2
    exit 1
fi

CCS_DIR=${CCS_DIR:-"$HOME/.config/ccs"}
PROVIDERS_DIR=$CCS_DIR/providers
ACTIVE_FILE=$CCS_DIR/active
SETTINGS_FILE=${CLAUDE_SETTINGS_FILE:-"$HOME/.claude/settings.json"}
# cmd_use --project retargets SETTINGS_FILE at the per-project file. The
# global path is kept separately so the bleed-through guard can still read
# which managed keys the global settings define.
GLOBAL_SETTINGS_FILE=$SETTINGS_FILE
PROJECT_SETTINGS_REL=.claude/settings.local.json

AUTH_API_KEY=api_key
AUTH_TOKEN=auth_token
ENV_API_KEY=ANTHROPIC_API_KEY
ENV_AUTH_TOKEN=ANTHROPIC_AUTH_TOKEN
# Built-in pseudo provider: `ccs use official` removes the managed provider
# env from settings.json so Claude Code falls back to its own claude.ai
# subscription login (OAuth). It has no .conf file and the name is reserved.
OFFICIAL_NAME=official
VERIFY_TIMEOUT=${CCS_VERIFY_TIMEOUT:-10}
VERIFY_PROBE_MODEL=${CCS_VERIFY_PROBE_MODEL:-claude-sonnet-4-6}

PROVIDER_ENV_KEYS="ANTHROPIC_BASE_URL ANTHROPIC_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL_NAME ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES ANTHROPIC_DEFAULT_SONNET_MODEL_NAME ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES ANTHROPIC_CUSTOM_MODEL_OPTION ANTHROPIC_CUSTOM_MODEL_OPTION_NAME ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION ANTHROPIC_CUSTOM_MODEL_OPTION_SUPPORTED_CAPABILITIES CLAUDE_CODE_SUBAGENT_MODEL CLAUDE_CODE_EFFORT_LEVEL"
MANAGED_ENV_KEYS="$PROVIDER_ENV_KEYS $ENV_API_KEY $ENV_AUTH_TOKEN"
FATAL_PROVIDER_ERROR_TYPES="authentication_error invalid_api_key model_not_found not_found_error permission_error"

TAB=$(printf '\t')
CR=$(printf '\r')
NL='
'

RESET=$(printf '\033[0m')
SELECTED=$(printf '\033[1;30;46m')
CLEAR_LINE=$(printf '\033[K')
ESC=$(printf '\033')
LEFT_KEY=$(printf '\033[D')
RIGHT_KEY=$(printf '\033[C')
ENTER_KEY=$(printf '\r')
CTRL_C=$(printf '\003')
CTRL_D=$(printf '\004')

die() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'warning: %s\n' "$*" >&2
}

# Shared message for every settings_parse refusal. The scanner exits non-zero
# on input it cannot safely round-trip -- malformed or truncated JSON, a BOM
# prefix, or a top-level "env" that is not an object -- and always leaves the
# file untouched. One helper keeps that explanation in a single place instead
# of a bare "cannot parse" repeated at every call site.
cannot_parse() {
    die "cannot parse $1: not safe to rewrite -- it may be malformed or truncated, carry a BOM, or its top-level \"env\" is not an object; left unchanged"
}

chmod_private_dir() {
    chmod 700 "$1" 2>/dev/null || warn "could not set permissions 700 on $1"
}

chmod_private_file() {
    chmod 600 "$1" 2>/dev/null || warn "could not set permissions 600 on $1"
}

# Single chokepoint for temp-file creation. The dir-prefixed template works on
# GNU coreutils, BSD/macOS, and modern busybox; centralizing keeps the form in
# one place should an older mktemp ever need a different invocation. Callers
# keep their own "|| exit 1" / "|| return 1" so failure handling stays local.
# $2 (optional) places the temp file in a specific directory: files that are
# later mv'd over a destination must be created on the destination filesystem,
# or mv degrades to a non-atomic copy+unlink across filesystem boundaries
# (e.g. tmpfs /tmp vs $HOME) and a crash mid-copy truncates the target.
make_temp() {
    mktemp "${2:-${TMPDIR:-/tmp}}/ccs-$1.XXXXXX"
}

usage() {
    cat <<'EOF'
ccs - Claude Code provider switcher

Usage:
  ccs init
  ccs set [name] [--base-url URL] [--key KEY] [--use-api-key|--use-auth-token]
                 [--model M] [--opus-model M] [--sonnet-model M] [--haiku-model M]
                 [--unset-model] [-e K=V] [--unset-env K]
  ccs preset <deepseek|openrouter> --key KEY [--name NAME]
  ccs use <name> [--no-verify] [--shell] [--project]
  ccs use official [--shell] [--project]
  ccs use --global
  ccs slim [--apply]
  ccs verify [name]
  ccs doctor
  ccs ls
  ccs current
  ccs show <name> [--show-key]
  ccs rm <name>

Note:
  ccs use rewrites settings.json; jq keeps nested JSON readable when available,
  otherwise the POSIX fallback minifies non-env top-level fields.
  'official' is built in: it removes the managed provider env so Claude Code
  uses your claude.ai subscription login instead (run /login once inside
  Claude Code).
  --project pins a provider for the current directory by writing
  ./.claude/settings.local.json (it must be git-ignored); 'use --global'
  removes that pin so the directory follows the global settings again.
  ccs slim removes project top-level keys that duplicate the global
  settings byte for byte; the per-key merge then inherits them, so the
  effective configuration does not change.
  Switching providers removes any apiKeyHelper from settings.json (it is a
  competing credential source); the pre-switch backup keeps it recoverable.
EOF
}

set_usage() {
    cat <<'EOF'
Usage: ccs set [OPTIONS] [NAME]

Create or update a provider.

Options:
  --base-url URL
  --key KEY             provider key/token; use '-' to read from stdin
  --use-api-key         write --key to ANTHROPIC_API_KEY
  --use-auth-token      write --key to ANTHROPIC_AUTH_TOKEN
  --model M             ANTHROPIC_MODEL override
  --opus-model M        ANTHROPIC_DEFAULT_OPUS_MODEL alias mapping
  --sonnet-model M      ANTHROPIC_DEFAULT_SONNET_MODEL alias mapping
  --haiku-model M       ANTHROPIC_DEFAULT_HAIKU_MODEL alias mapping
  --unset-model         remove ANTHROPIC_MODEL
  -e, --env K=V         extra supported provider env
  --unset-env K         remove a supported provider env key
  --help                show this help
EOF
}

preset_usage() {
    cat <<'EOF'
Usage: ccs preset <PRESET> --key KEY [--name NAME]

Create or update a provider from a known Claude Code recipe.

Presets:
  deepseek      https://api.deepseek.com/anthropic with auth token defaults
  openrouter    https://openrouter.ai/api with auth token defaults

Options:
  --key KEY     provider key/token; use '-' to read from stdin
  --name NAME   provider name to write; defaults to the preset name
  --help        show this help
EOF
}

ensure_dirs() {
    mkdir -p "$PROVIDERS_DIR" || die "cannot create $PROVIDERS_DIR"
    chmod_private_dir "$CCS_DIR"
    chmod_private_dir "$PROVIDERS_DIR"
}

provider_file() {
    printf '%s/%s.conf' "$PROVIDERS_DIR" "$1"
}

valid_provider_name() {
    printf '%s' "$1" | grep -Eq '^[A-Za-z0-9._-]+$'
}

require_provider_name() {
    name=$1
    [ -n "$name" ] || die "provider name is required"
    valid_provider_name "$name" || die "provider name may only contain letters, numbers, dot, underscore, and dash"
}

# Reject values containing a newline, tab, or carriage return. The provider
# .conf format is line-based (KEY=VALUE\n) and the settings env intermediate is
# tab-delimited, so such bytes would corrupt the round-trip or inject extra
# KEY=VALUE lines. $2 names the field for the error message.
reject_control_chars() {
    case "$1" in
        *"$NL"*|*"$TAB"*|*"$CR"*)
            die "${2:-value} may not contain newline, tab, or carriage return"
            ;;
    esac
}

is_allowed_env_key() {
    case " $PROVIDER_ENV_KEYS " in
        *" $1 "*) return 0 ;;
        *) return 1 ;;
    esac
}

validate_env_key() {
    is_allowed_env_key "$1" || die "unsupported env key '$1'"
}

masked_key() {
    key=$1
    if [ -z "$key" ]; then
        printf '<empty>'
    else
        printf '<len=%s>' "$(printf '%s' "$key" | wc -c | tr -d ' ')"
    fi
}

secret_env_name() {
    if [ "${1:-$AUTH_API_KEY}" = "$AUTH_TOKEN" ]; then
        printf '%s' "$ENV_AUTH_TOKEN"
    else
        printf '%s' "$ENV_API_KEY"
    fi
}

prefers_auth_token() {
    case "$1" in
        https://api.deepseek.com/anthropic|https://api.deepseek.com/anthropic/*) return 0 ;;
        *) return 1 ;;
    esac
}

conf_get() {
    file=$1
    key=$2
    [ -f "$file" ] || return 0
    awk -v k="$key" 'index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$file"
}

provider_exists() {
    [ -f "$(provider_file "$1")" ]
}

provider_env_to_file() {
    file=$1
    out=$2
    : >"$out"
    [ -f "$file" ] || return 0
    awk -v allowed=" $PROVIDER_ENV_KEYS " '
        {
            pos = index($0, "=")
            if (pos == 0) next
            key = substr($0, 1, pos - 1)
            if (index(allowed, " " key " ") > 0) print $0
        }
    ' "$file" >"$out"
}

env_file_write() {
    file=$1
    key=$2
    tmp=$(make_temp env) || exit 1
    if [ -f "$file" ]; then
        awk -v k="$key" 'index($0, k "=") != 1 { print }' "$file" >"$tmp" || {
            rm -f "$tmp"
            die "cannot rewrite $file"
        }
    fi
    if [ "$#" -gt 2 ]; then
        value=$3
        if [ -n "$value" ]; then
            reject_control_chars "$value" "$key"
            printf '%s=%s\n' "$key" "$value" >>"$tmp"
        fi
    fi
    mv "$tmp" "$file" || {
        rm -f "$tmp"
        die "cannot update $file"
    }
}

write_provider() {
    name=$1
    auth=$2
    key=$3
    env_file=$4
    reject_control_chars "$key" "key"
    file=$(provider_file "$name")
    tmp=$(make_temp provider "$PROVIDERS_DIR") || exit 1
    {
        printf 'auth=%s\n' "$auth"
        printf 'key=%s\n' "$key"
        awk -v keys="$PROVIDER_ENV_KEYS" '
            {
                pos = index($0, "=")
                if (pos == 0) next
                key = substr($0, 1, pos - 1)
                value = substr($0, pos + 1)
                values[key] = value
            }
            END {
                count = split(keys, order, " ")
                for (i = 1; i <= count; i++) {
                    key = order[i]
                    if (key in values) print key "=" values[key]
                }
            }
        ' "$env_file"
    } >"$tmp" || {
        rm -f "$tmp"
        die "cannot write provider file $file"
    }
    chmod_private_file "$tmp"
    mv "$tmp" "$file" || {
        rm -f "$tmp"
        die "cannot write provider file $file"
    }
}

# json_quote and curl_config_quote accumulate the whole input across records
# (awk splits on newline, so an embedded newline never reaches $0 and must be
# rebuilt) before escaping. This makes the "\n" branch reachable instead of
# silently dropping embedded newlines.
json_quote() {
    awk '
        BEGIN {
            ORS = ""
            for (n = 1; n < 32; n++) ctrl[sprintf("%c", n)] = n
        }
        NR > 1 { s = s "\n" }
        { s = s $0 }
        END {
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c == "\\") printf "\\\\"
                else if (c == "\"") printf "\\\""
                else if (c == "\b") printf "\\b"
                else if (c == "\f") printf "\\f"
                else if (c == "\n") printf "\\n"
                else if (c == "\t") printf "\\t"
                else if (c == "\r") printf "\\r"
                else if (c in ctrl) printf "\\u%04x", ctrl[c]
                else printf "%s", c
            }
        }
    '
}

# Deliberately a subset of json_quote: curl config files use C-style backslash
# escapes and do NOT interpret \b \f or \uXXXX, so those must pass through
# literally rather than be JSON-escaped. Do not merge with json_quote.
curl_config_quote() {
    awk '
        BEGIN { ORS = "" }
        NR > 1 { s = s "\n" }
        { s = s $0 }
        END {
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                if (c == "\\") printf "\\\\"
                else if (c == "\"") printf "\\\""
                else if (c == "\n") printf "\\n"
                else if (c == "\t") printf "\\t"
                else if (c == "\r") printf "\\r"
                else printf "%s", c
            }
        }
    '
}

settings_parse() {
    mode=$1
    file=$2
    [ -f "$file" ] || return 0
    # LC_ALL=C pins byte semantics: BSD awk's regex engine otherwise attempts
    # multibyte conversion on substr()-sliced bytes and aborts on files whose
    # bytes are not valid UTF-8 (e.g. a BOM), and gawk would index by
    # characters instead of bytes. JSON structure is pure ASCII either way.
    LC_ALL=C awk -v mode="$mode" -v managed=" $MANAGED_ENV_KEYS " '
        function skip_ws(i) {
            while (i <= n && substr(s, i, 1) ~ /[ \t\r\n]/) i++
            return i
        }
        function scan_string(i,    c, esc) {
            i++
            esc = 0
            while (i <= n) {
                c = substr(s, i, 1)
                if (esc) esc = 0
                else if (c == "\\") esc = 1
                else if (c == "\"") return i + 1
                i++
            }
            return i
        }
        function scan_value(i,    c, depth, esc, in_str) {
            c = substr(s, i, 1)
            if (c == "\"") return scan_string(i)
            if (c == "{" || c == "[") {
                depth = 0
                in_str = 0
                esc = 0
                while (i <= n) {
                    c = substr(s, i, 1)
                    if (in_str) {
                        if (esc) esc = 0
                        else if (c == "\\") esc = 1
                        else if (c == "\"") in_str = 0
                    } else {
                        if (c == "\"") in_str = 1
                        else if (c == "{" || c == "[") depth++
                        else if (c == "}" || c == "]") {
                            depth--
                            if (depth == 0) return i + 1
                        }
                    }
                    i++
                }
                return i
            }
            while (i <= n) {
                c = substr(s, i, 1)
                if (c == "," || c == "}" || c == "]") return i
                i++
            }
            return i
        }
        function hexval(ch) {
            return index("0123456789abcdef", tolower(ch)) - 1
        }
        function unquote(raw,    i, c, out, esc, u, hi, lo, cp) {
            out = ""
            i = 2
            while (i < length(raw)) {
                c = substr(raw, i, 1)
                if (c == "\\") {
                    i++
                    c = substr(raw, i, 1)
                    if (c == "\"" || c == "\\" || c == "/") out = out c
                    else if (c == "b") out = out "\b"
                    else if (c == "f") out = out "\f"
                    else if (c == "n") out = out "\n"
                    else if (c == "r") out = out "\r"
                    else if (c == "t") out = out "\t"
                    else if (c == "u") {
                        u = substr(raw, i + 1, 4)
                        # Decode ASCII-range escapes (\x00-\x7f) to the real
                        # character so an escaped key like ANTHROPIC_API_KEY is
                        # recognized as managed. Non-ASCII escapes are kept
                        # literal (they are never managed key names).
                        if (u ~ /^00[0-7][0-9A-Fa-f]$/) {
                            cp = hexval(substr(u, 3, 1)) * 16 + hexval(substr(u, 4, 1))
                            out = out sprintf("%c", cp)
                        } else {
                            out = out "\\u" u
                        }
                        i += 4
                    } else out = out c
                } else out = out c
                i++
            }
            return out
        }
        function minify(raw,    i, c, out, esc, in_str) {
            out = ""
            esc = 0
            in_str = 0
            for (i = 1; i <= length(raw); i++) {
                c = substr(raw, i, 1)
                if (in_str) {
                    out = out c
                    if (esc) esc = 0
                    else if (c == "\\") esc = 1
                    else if (c == "\"") in_str = 0
                } else {
                    if (c == "\"") {
                        in_str = 1
                        out = out c
                    } else if (c !~ /[ \t\r\n]/) out = out c
                }
            }
            return out
        }
        function is_managed(key) {
            return index(managed, " " key " ") > 0
        }
        # Returns 1 when the env object was walked to its closing brace, 0 on
        # any malformed content so the caller can abort instead of treating a
        # half-read env block as the complete truth.
        function emit_env(vs, ve, which,    i, c, key_start, key_end, key, colon, value_start, value_end, raw_value) {
            if (substr(s, skip_ws(vs), 1) != "{") return 0
            i = skip_ws(vs) + 1
            while (i < ve) {
                i = skip_ws(i)
                c = substr(s, i, 1)
                if (c == "}") return 1
                if (c != "\"") return 0
                key_start = i
                key_end = scan_string(i)
                key = unquote(substr(s, key_start, key_end - key_start))
                colon = skip_ws(key_end)
                if (substr(s, colon, 1) != ":") return 0
                value_start = skip_ws(colon + 1)
                value_end = scan_value(value_start)
                raw_value = substr(s, value_start, value_end - value_start)
                if (which == "managed") {
                    if (is_managed(key)) {
                        printf "%s\t%s\n", key, minify(raw_value)
                    }
                } else if (!is_managed(key)) {
                    printf "%s\t%s\n", key, minify(raw_value)
                }
                i = skip_ws(value_end)
                if (substr(s, i, 1) == ",") i++
            }
            return 1
        }
        {
            s = s $0 "\n"
        }
        # The END walk is strict: a file this scanner cannot follow to the
        # closing brace exits 1 so callers refuse to rewrite settings.json
        # from a partial read (silently treating unparseable input as empty
        # is how user config gets erased). Empty/whitespace-only input is
        # fine: there is nothing to lose.
        END {
            n = length(s)
            i = skip_ws(1)
            if (i > n) exit 0
            if (substr(s, i, 1) != "{") exit 1
            i++
            closed = 0
            while (i <= n) {
                i = skip_ws(i)
                if (substr(s, i, 1) == "}") {
                    closed = 1
                    i++
                    break
                }
                if (substr(s, i, 1) != "\"") exit 1
                field_start = i
                key_start = i
                key_end = scan_string(i)
                key = unquote(substr(s, key_start, key_end - key_start))
                colon = skip_ws(key_end)
                if (substr(s, colon, 1) != ":") exit 1
                value_start = skip_ws(colon + 1)
                value_end = scan_value(value_start)
                if (mode == "env" && key == "env") {
                    if (!emit_env(value_start, value_end, "keep")) exit 1
                } else if (mode == "managed" && key == "env") {
                    if (!emit_env(value_start, value_end, "managed")) exit 1
                } else if (mode == "other" && key != "env" && key != "apiKeyHelper") {
                    print minify(substr(s, field_start, value_end - field_start))
                }
                i = skip_ws(value_end)
                if (substr(s, i, 1) == ",") i++
            }
            if (!closed) exit 1
            if (skip_ws(i) <= n) exit 1
        }
    ' "$file"
}

env_file_to_json() {
    env_file=$1
    tab=$(printf '\t')
    printf '{\n'
    env_first=1
    while IFS="$tab" read -r key raw_value; do
        [ -n "$key" ] || continue
        if [ "$env_first" -eq 0 ]; then
            printf ',\n'
        fi
        printf '  "'
        printf '%s' "$key" | json_quote
        printf '": %s' "$raw_value"
        env_first=0
    done <"$env_file"
    printf '\n}\n'
}

write_settings_json_with_jq() {
    env_file=$1
    out_file=$2
    env_json_tmp=$(make_temp env-json) || exit 1
    env_file_to_json "$env_file" >"$env_json_tmp" || {
        rm -f "$env_json_tmp"
        return 1
    }
    # -s, not -f: jq emits nothing (rc 0) for an empty input file, which would
    # commit a zero-byte settings.json that Claude Code reads as no config at
    # all. Treat empty the same as absent and build a fresh object instead.
    if [ -s "$SETTINGS_FILE" ]; then
        jq --slurpfile ccs_env "$env_json_tmp" \
            'if type == "object" then del(.apiKeyHelper) | .env = $ccs_env[0] else {"env": $ccs_env[0]} end' \
            "$SETTINGS_FILE" >"$out_file"
    else
        jq --slurpfile ccs_env "$env_json_tmp" -n '{"env": $ccs_env[0]}' >"$out_file"
    fi
    rc=$?
    rm -f "$env_json_tmp"
    [ "$rc" -eq 0 ] || return 1
    # Never commit an empty rewrite: whatever jq produced, an empty file is
    # strictly worse than the awk fallback's output.
    [ -s "$out_file" ] || return 1
}

# Snapshot the settings file before every rewrite. settings.json carries
# config ccs does not own (permissions, hooks, ...), so any rewrite bug must
# be recoverable. Failure to back up only warns: blocking the switch would
# turn a safety net into a new failure mode. Glob expansion sorts the
# timestamped names chronologically, so pruning drops the oldest first.
backup_settings_file() {
    [ -s "$SETTINGS_FILE" ] || return 0
    backups_dir=$CCS_DIR/backups
    mkdir -p "$backups_dir" || {
        warn "cannot create $backups_dir; continuing without a settings backup"
        return 0
    }
    chmod_private_dir "$backups_dir"
    backup_file=$backups_dir/settings-$(date +%Y%m%d-%H%M%S)-$$.json
    if cp "$SETTINGS_FILE" "$backup_file" 2>/dev/null; then
        chmod_private_file "$backup_file"
        set -- "$backups_dir"/settings-*.json
        while [ "$#" -gt 10 ]; do
            rm -f "$1"
            shift
        done
    else
        warn "could not back up $SETTINGS_FILE before rewriting"
    fi
}

write_settings_json() {
    other_file=$1
    env_file=$2
    settings_dir=$(dirname "$SETTINGS_FILE")
    if [ -e "$SETTINGS_FILE" ] && [ ! -f "$SETTINGS_FILE" ]; then
        die "settings path exists but is not a regular file: $SETTINGS_FILE"
    fi
    mkdir -p "$settings_dir" || die "cannot create settings directory"
    backup_settings_file
    tmp=$(make_temp settings "$settings_dir") || exit 1
    if command -v jq >/dev/null 2>&1; then
        if ! write_settings_json_with_jq "$env_file" "$tmp"; then
            # jq is installed but failed on this settings.json. The awk fallback
            # is more lenient and may silently drop top-level fields it cannot
            # parse, so warn before falling back rather than losing data quietly.
            [ ! -f "$SETTINGS_FILE" ] || warn "jq could not process $SETTINGS_FILE; falling back to the POSIX writer (some top-level fields may be dropped)"
            write_settings_json_awk "$other_file" "$env_file" "$tmp"
        fi
    else
        write_settings_json_awk "$other_file" "$env_file" "$tmp"
    fi
    chmod_private_file "$tmp"
    mv "$tmp" "$SETTINGS_FILE" || {
        rm -f "$tmp"
        die "cannot write settings file: $SETTINGS_FILE"
    }
}

# POSIX fallback writer used when jq is absent or fails. Emits non-env
# top-level fields verbatim (already minified by settings_parse) plus the
# managed env object. The caller chmods and commits $tmp.
write_settings_json_awk() {
    other_file=$1
    env_file=$2
    tmp=$3
    {
        printf '{\n'
        first=1
        while IFS= read -r field; do
            [ -n "$field" ] || continue
            if [ "$first" -eq 0 ]; then
                printf ',\n'
            fi
            printf '  %s' "$field"
            first=0
        done <"$other_file"
        if [ "$first" -eq 0 ]; then
            printf ',\n'
        fi
        printf '  "env": {\n'
        env_first=1
        tab=$(printf '\t')
        while IFS="$tab" read -r key raw_value; do
            [ -n "$key" ] || continue
            if [ "$env_first" -eq 0 ]; then
                printf ',\n'
            fi
            printf '    "'
            printf '%s' "$key" | json_quote
            printf '": %s' "$raw_value"
            env_first=0
        done <"$env_file"
        printf '\n  }\n'
        printf '}\n'
    } >"$tmp" || {
        rm -f "$tmp"
        die "cannot write temporary settings file"
    }
}

settings_env_set() {
    file=$1
    key=$2
    value=$3
    tmp=$(make_temp env) || exit 1
    awk -F '\t' -v k="$key" '$1 != k { print }' "$file" >"$tmp" || {
        rm -f "$tmp"
        die "cannot update temporary env file"
    }
    # An empty value normally removes the key; "force" writes it as "" instead
    # (the project-mode bleed-through guard relies on Claude Code treating an
    # empty env value as unset).
    if [ -n "$value" ] || [ "${4:-}" = "force" ]; then
        {
            printf '%s\t"' "$key"
            printf '%s' "$value" | json_quote
            printf '"\n'
        } >>"$tmp" || {
            rm -f "$tmp"
            die "cannot update temporary env file"
        }
    fi
    mv "$tmp" "$file" || {
        rm -f "$tmp"
        die "cannot update $file"
    }
}

# apply_provider and clear_provider_env run their temp-file bookkeeping in a
# subshell so their cleanup trap is isolated. Setting a trap in the function
# body directly would overwrite a caller's EXIT/INT trap (e.g. cmd_set's), so
# the subshell keeps trap scope local; `|| exit $?` propagates die's failure.
# Signal traps must exit explicitly: a bare cleanup trap would remove the
# work files and then let the interrupted command sequence keep running.
apply_provider() {
    name=$1
    provider_path=$(provider_file "$name")
    [ -f "$provider_path" ] || die "no such provider: '$name'"

    auth=$(conf_get "$provider_path" auth)
    [ -n "$auth" ] || auth=$AUTH_API_KEY
    provider_key=$(conf_get "$provider_path" key)
    [ -n "$provider_key" ] || die "provider '$name' has empty key"

    (
        env_tmp=
        other_tmp=
        provider_env_tmp=
        global_managed_tmp=
        trap 'rm -f "$env_tmp" "$other_tmp" "$provider_env_tmp" "$global_managed_tmp"' EXIT
        trap 'exit 130' HUP INT TERM
        env_tmp=$(make_temp env) || exit 1
        other_tmp=$(make_temp other) || exit 1
        provider_env_tmp=$(make_temp provider-env) || exit 1

        settings_parse other "$SETTINGS_FILE" >"$other_tmp" || cannot_parse "$SETTINGS_FILE"
        settings_parse env "$SETTINGS_FILE" >"$env_tmp" || cannot_parse "$SETTINGS_FILE"

        provider_env_to_file "$provider_path" "$provider_env_tmp"

        # Project mode bleed-through guard: managed keys that the global
        # settings define but this provider does not would fall through
        # Claude Code's per-key settings merge (project local overrides per
        # key; absent keys inherit the global value). Write them as "" --
        # Claude Code treats an empty env value as unset. The opposite-auth
        # secret is deliberately included, which also prevents the
        # "Both a token and an API key are set" conflict.
        # Staged through a temp file, not a pipe: a parse failure inside a
        # pipeline would be swallowed and the pin would silently lose its
        # guard against global key bleed-through.
        if [ "${use_project:-0}" -eq 1 ]; then
            secret_key=$(secret_env_name "$auth")
            global_managed_tmp=$(make_temp global-managed) || exit 1
            settings_parse managed "$GLOBAL_SETTINGS_FILE" >"$global_managed_tmp" || cannot_parse "$GLOBAL_SETTINGS_FILE"
            while IFS="$TAB" read -r gkey _; do
                [ -n "$gkey" ] || continue
                [ "$gkey" != "$secret_key" ] || continue
                [ -z "$(conf_get "$provider_env_tmp" "$gkey")" ] || continue
                settings_env_set "$env_tmp" "$gkey" "" force
            done <"$global_managed_tmp"
        fi

        while IFS= read -r line; do
            [ -n "$line" ] || continue
            settings_env_set "$env_tmp" "${line%%=*}" "${line#*=}"
        done <"$provider_env_tmp"

        settings_env_set "$env_tmp" "$(secret_env_name "$auth")" "$provider_key"
        write_settings_json "$other_tmp" "$env_tmp"
    ) || exit $?
}

clear_provider_env() {
    (
        env_tmp=
        other_tmp=
        trap 'rm -f "$env_tmp" "$other_tmp"' EXIT
        trap 'exit 130' HUP INT TERM
        env_tmp=$(make_temp env) || exit 1
        other_tmp=$(make_temp other) || exit 1
        settings_parse other "$SETTINGS_FILE" >"$other_tmp" || cannot_parse "$SETTINGS_FILE"
        settings_parse env "$SETTINGS_FILE" >"$env_tmp" || cannot_parse "$SETTINGS_FILE"
        write_settings_json "$other_tmp" "$env_tmp"
    ) || exit $?
}

# Pin the claude.ai subscription inside the project file: blank every managed
# key the global settings currently define, plus the auth/url/model core that
# any future global provider would define, so none of them bleed through the
# per-key settings merge. Claude Code treats an empty env value as unset.
apply_official_project() {
    (
        env_tmp=
        other_tmp=
        official_keys_tmp=
        trap 'rm -f "$env_tmp" "$other_tmp" "$official_keys_tmp"' EXIT
        trap 'exit 130' HUP INT TERM
        env_tmp=$(make_temp env) || exit 1
        other_tmp=$(make_temp other) || exit 1
        official_keys_tmp=$(make_temp official-keys) || exit 1
        settings_parse other "$SETTINGS_FILE" >"$other_tmp" || cannot_parse "$SETTINGS_FILE"
        settings_parse env "$SETTINGS_FILE" >"$env_tmp" || cannot_parse "$SETTINGS_FILE"
        # Staged through temp files so a parse failure dies instead of being
        # swallowed by a pipeline while the pin reports success.
        global_managed=$(settings_parse managed "$GLOBAL_SETTINGS_FILE") || cannot_parse "$GLOBAL_SETTINGS_FILE"
        {
            [ -z "$global_managed" ] || printf '%s\n' "$global_managed" | awk -F '\t' '{ print $1 }'
            printf '%s\n%s\n%s\n%s\n' ANTHROPIC_BASE_URL "$ENV_API_KEY" "$ENV_AUTH_TOKEN" ANTHROPIC_MODEL
        } | sort -u >"$official_keys_tmp" || die "cannot stage official env keys"
        while IFS= read -r gkey; do
            [ -n "$gkey" ] || continue
            settings_env_set "$env_tmp" "$gkey" "" force
        done <"$official_keys_tmp"
        write_settings_json "$other_tmp" "$env_tmp"
    ) || exit $?
}

prompt_required() {
    label=$1
    default=${2:-}
    if [ -n "$default" ]; then
        printf '%s [%s]: ' "$label" "$default" >&2
    else
        printf '%s: ' "$label" >&2
    fi
    IFS= read -r value || exit 1
    if [ -z "$value" ]; then
        value=$default
    fi
    [ -n "$value" ] || die "$label is required"
    printf '%s' "$value"
}

prompt_optional() {
    label=$1
    default=${2:-}
    hide=${3:-0}
    if [ -n "$default" ]; then
        printf '%s [%s]: ' "$label" "$default" >&2
    else
        printf '%s: ' "$label" >&2
    fi
    if [ "$hide" = 1 ] && [ -t 0 ]; then
        old=$(stty -g)
        trap 'stty "$old" 2>/dev/null; trap - HUP INT TERM; exit 130' HUP INT TERM
        stty -echo
        IFS= read -r value || value=
        stty "$old"
        trap - HUP INT TERM
        printf '\n' >&2
    else
        IFS= read -r value || value=
    fi
    if [ -z "$value" ]; then
        value=$default
    fi
    printf '%s' "$value"
}

render_auth_selector() {
    selected=$1
    api="  $ENV_API_KEY  "
    token="  $ENV_AUTH_TOKEN  "
    if [ "$selected" -eq 0 ]; then
        api="$SELECTED $ENV_API_KEY $RESET"
    else
        token="$SELECTED $ENV_AUTH_TOKEN $RESET"
    fi
    printf 'Secret env (<-/->, Enter): %s  %s' "$api" "$token"
}

prompt_auth() {
    default_auth=${1:-$AUTH_API_KEY}
    selected=0
    [ "$default_auth" = "$AUTH_TOKEN" ] && selected=1

    if [ -t 0 ] && [ -t 2 ]; then
        old=$(stty -g)
        trap 'stty "$old" 2>/dev/null; trap - HUP INT TERM; exit 130' HUP INT TERM
        stty raw -echo
        render_auth_selector "$selected" >&2
        while :; do
            key=$(dd bs=1 count=1 2>/dev/null || true)
            if [ "$key" = "$ESC" ]; then
                key2=$(dd bs=1 count=1 2>/dev/null || true)
                key3=$(dd bs=1 count=1 2>/dev/null || true)
                key=$key$key2$key3
            fi
            if [ "$key" = "$ENTER_KEY" ] || [ -z "$key" ]; then
                stty "$old"
                trap - HUP INT TERM
                printf '\r\n' >&2
                [ "$selected" -eq 1 ] && printf '%s' "$AUTH_TOKEN" || printf '%s' "$AUTH_API_KEY"
                return 0
            fi
            if [ "$key" = "$CTRL_C" ] || [ "$key" = "$CTRL_D" ]; then
                stty "$old"
                trap - HUP INT TERM
                printf '\r\n' >&2
                exit 1
            fi
            if [ "$key" = "$LEFT_KEY" ] || [ "$key" = "$RIGHT_KEY" ]; then
                [ "$selected" -eq 0 ] && selected=1 || selected=0
                printf '\r%s' "$CLEAR_LINE" >&2
                render_auth_selector "$selected" >&2
            fi
        done
    fi

    prompt='Use ANTHROPIC_AUTH_TOKEN / Bearer auth?'
    if [ "$default_auth" = "$AUTH_TOKEN" ]; then
        printf '%s [Y/n]: ' "$prompt" >&2
        IFS= read -r answer || answer=
        case "$answer" in
            n|N|no|NO|No) printf '%s' "$AUTH_API_KEY" ;;
            *) printf '%s' "$AUTH_TOKEN" ;;
        esac
    else
        printf '%s [y/N]: ' "$prompt" >&2
        IFS= read -r answer || answer=
        case "$answer" in
            y|Y|yes|YES|Yes) printf '%s' "$AUTH_TOKEN" ;;
            *) printf '%s' "$AUTH_API_KEY" ;;
        esac
    fi
}

active_name() {
    [ -f "$ACTIVE_FILE" ] && sed -n '1p' "$ACTIVE_FILE"
}

# set_active returns non-zero (rather than die) so callers can report a
# settings/active inconsistency when the pointer update fails after settings
# were already written.
set_active() {
    name=$1
    mkdir -p "$CCS_DIR" || return 1
    tmp=$(make_temp active "$CCS_DIR") || return 1
    printf '%s\n' "$name" >"$tmp" || {
        rm -f "$tmp"
        return 1
    }
    chmod_private_file "$tmp"
    mv "$tmp" "$ACTIVE_FILE" || {
        rm -f "$tmp"
        return 1
    }
}

clear_active() {
    mkdir -p "$CCS_DIR" || return 1
    tmp=$(make_temp active "$CCS_DIR") || return 1
    : >"$tmp" || {
        rm -f "$tmp"
        return 1
    }
    chmod_private_file "$tmp"
    mv "$tmp" "$ACTIVE_FILE" || {
        rm -f "$tmp"
        return 1
    }
}

cmd_init() {
    ensure_dirs
    [ -f "$ACTIVE_FILE" ] || : >"$ACTIVE_FILE"
    chmod_private_file "$ACTIVE_FILE"
    printf 'ok dir:    %s\n' "$CCS_DIR"
    printf 'Set a provider:   ccs set <name> --base-url <url> --key <key>\n'
}

cmd_set() {
    for arg do
        case "$arg" in
            --help) set_usage; return 0 ;;
        esac
    done

    ensure_dirs
    name=
    base_url=
    key_arg=
    auth_flag=
    model=
    opus_model=
    sonnet_model=
    haiku_model=
    unset_model=0
    options_provided=0
    env_updates=
    env_unsets=
    env_tmp=
    trap 'rm -f "$env_updates" "$env_unsets" "$env_tmp"' EXIT
    trap 'exit 130' HUP INT TERM
    env_updates=$(make_temp env-updates) || exit 1
    env_unsets=$(make_temp env-unsets) || exit 1
    : >"$env_updates"
    : >"$env_unsets"

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --help)
                set_usage
                return 0
                ;;
            --base-url)
                [ "$#" -ge 2 ] || die "--base-url requires a value"
                base_url=$2
                options_provided=1
                shift 2
                ;;
            --key)
                [ "$#" -ge 2 ] || die "--key requires a value"
                key_arg=$2
                options_provided=1
                shift 2
                ;;
            --use-api-key)
                [ -z "$auth_flag" ] || die "--use-api-key and --use-auth-token cannot be used together"
                auth_flag=$AUTH_API_KEY
                options_provided=1
                shift
                ;;
            --use-auth-token)
                [ -z "$auth_flag" ] || die "--use-api-key and --use-auth-token cannot be used together"
                auth_flag=$AUTH_TOKEN
                options_provided=1
                shift
                ;;
            --model)
                [ "$#" -ge 2 ] || die "--model requires a value"
                model=$2
                options_provided=1
                shift 2
                ;;
            --opus-model)
                [ "$#" -ge 2 ] || die "--opus-model requires a value"
                opus_model=$2
                options_provided=1
                shift 2
                ;;
            --sonnet-model)
                [ "$#" -ge 2 ] || die "--sonnet-model requires a value"
                sonnet_model=$2
                options_provided=1
                shift 2
                ;;
            --haiku-model)
                [ "$#" -ge 2 ] || die "--haiku-model requires a value"
                haiku_model=$2
                options_provided=1
                shift 2
                ;;
            --unset-model)
                unset_model=1
                options_provided=1
                shift
                ;;
            -e|--env)
                [ "$#" -ge 2 ] || die "$1 requires KEY=VALUE"
                case "$2" in
                    *=*) ;;
                    *) die "$1 requires KEY=VALUE" ;;
                esac
                env_key=${2%%=*}
                env_value=${2#*=}
                validate_env_key "$env_key"
                reject_control_chars "$env_value" "$env_key"
                printf '%s=%s\n' "$env_key" "$env_value" >>"$env_updates"
                options_provided=1
                shift 2
                ;;
            --unset-env)
                [ "$#" -ge 2 ] || die "--unset-env requires a key"
                validate_env_key "$2"
                [ "$2" != "ANTHROPIC_BASE_URL" ] || die "ANTHROPIC_BASE_URL cannot be removed; use --base-url to replace it"
                printf '%s\n' "$2" >>"$env_unsets"
                options_provided=1
                shift 2
                ;;
            --*)
                die "unknown option: $1"
                ;;
            *)
                [ -z "$name" ] || die "unexpected argument: $1"
                name=$1
                shift
                ;;
        esac
    done

    if [ -z "$name" ]; then
        name=$(prompt_required "Provider name")
    fi
    require_provider_name "$name"
    [ "$name" != "$OFFICIAL_NAME" ] || die "'$OFFICIAL_NAME' is reserved for the claude.ai subscription (ccs use $OFFICIAL_NAME)"

    file=$(provider_file "$name")
    created=0
    [ -f "$file" ] || created=1
    env_tmp=$(make_temp env) || exit 1
    provider_env_to_file "$file" "$env_tmp"
    current_auth=$(conf_get "$file" auth)
    [ -n "$current_auth" ] || current_auth=$AUTH_API_KEY
    current_key=$(conf_get "$file" key)
    current_base_url=$(conf_get "$env_tmp" ANTHROPIC_BASE_URL)
    current_model=$(conf_get "$env_tmp" ANTHROPIC_MODEL)
    current_opus_model=$(conf_get "$env_tmp" ANTHROPIC_DEFAULT_OPUS_MODEL)
    current_sonnet_model=$(conf_get "$env_tmp" ANTHROPIC_DEFAULT_SONNET_MODEL)
    current_haiku_model=$(conf_get "$env_tmp" ANTHROPIC_DEFAULT_HAIKU_MODEL)

    auth=$current_auth
    [ -n "$auth_flag" ] && auth=$auth_flag

    if [ "$options_provided" -eq 0 ]; then
        base_url=$(prompt_required "Base URL" "$current_base_url")
        if [ "$created" -eq 1 ] && prefers_auth_token "$base_url"; then
            auth=$AUTH_TOKEN
        fi
        auth=$(prompt_auth "$auth")
        env_name=$(secret_env_name "$auth")
        if [ "$created" -eq 1 ]; then
            key_arg=$(prompt_optional "Key for $env_name" "" 1)
        else
            key_arg=$(prompt_optional "Key for $env_name (enter to keep current $(masked_key "$current_key"))" "" 1)
        fi
        model=$(prompt_optional "Model (optional)" "$current_model" 0)
        opus_default=$current_opus_model
        [ -n "$opus_default" ] || opus_default=$model
        opus_model=$(prompt_optional "Opus model (optional)" "$opus_default" 0)
        sonnet_default=$current_sonnet_model
        [ -n "$sonnet_default" ] || sonnet_default=$model
        sonnet_model=$(prompt_optional "Sonnet model (optional)" "$sonnet_default" 0)
        haiku_default=$current_haiku_model
        [ -n "$haiku_default" ] || haiku_default=$model
        haiku_model=$(prompt_optional "Haiku model (optional)" "$haiku_default" 0)
    elif [ "$created" -eq 1 ]; then
        [ -n "$base_url" ] || base_url=$(prompt_required "Base URL")
        if [ -z "$auth_flag" ] && prefers_auth_token "$base_url"; then
            auth=$AUTH_TOKEN
        fi
        if [ -z "$key_arg" ]; then
            key_arg=$(prompt_optional "Key for $(secret_env_name "$auth")" "" 1)
        fi
    fi

    if [ "$key_arg" = "-" ]; then
        IFS= read -r key_arg || key_arg=
    fi
    if [ -n "$key_arg" ]; then
        current_key=$key_arg
    fi
    [ -n "$current_key" ] || die "--key is required when creating a provider"

    if [ -n "$base_url" ]; then
        env_file_write "$env_tmp" ANTHROPIC_BASE_URL "$base_url"
    fi
    while IFS= read -r env_key; do
        [ -n "$env_key" ] || continue
        env_file_write "$env_tmp" "$env_key"
    done <"$env_unsets"
    if [ "$unset_model" -eq 1 ]; then
        env_file_write "$env_tmp" ANTHROPIC_MODEL
    fi
    if [ -n "$model" ]; then
        env_file_write "$env_tmp" ANTHROPIC_MODEL "$model"
    fi
    if [ -n "$opus_model" ]; then
        env_file_write "$env_tmp" ANTHROPIC_DEFAULT_OPUS_MODEL "$opus_model"
    fi
    if [ -n "$sonnet_model" ]; then
        env_file_write "$env_tmp" ANTHROPIC_DEFAULT_SONNET_MODEL "$sonnet_model"
    fi
    if [ -n "$haiku_model" ]; then
        env_file_write "$env_tmp" ANTHROPIC_DEFAULT_HAIKU_MODEL "$haiku_model"
    fi
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        env_file_write "$env_tmp" "${line%%=*}" "${line#*=}"
    done <"$env_updates"

    [ -n "$(conf_get "$env_tmp" ANTHROPIC_BASE_URL)" ] || die "ANTHROPIC_BASE_URL is required"

    write_provider "$name" "$auth" "$current_key" "$env_tmp"
    if [ "$(active_name)" = "$name" ]; then
        apply_provider "$name"
        printf '%s %s (active reapplied)\n' "$([ "$created" -eq 1 ] && printf created || printf updated)" "$name"
    else
        printf '%s %s\n' "$([ "$created" -eq 1 ] && printf created || printf updated)" "$name"
    fi

    rm -f "$env_updates" "$env_unsets" "$env_tmp"
    trap - HUP INT TERM EXIT
}

cmd_preset() {
    for arg do
        case "$arg" in
            --help) preset_usage; return 0 ;;
        esac
    done

    [ "$#" -ge 1 ] || {
        preset_usage
        exit 1
    }
    preset=$1
    shift

    preset_key=
    preset_name=
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --help)
                preset_usage
                return 0
                ;;
            --key)
                [ "$#" -ge 2 ] || die "--key requires a value"
                preset_key=$2
                shift 2
                ;;
            --name)
                [ "$#" -ge 2 ] || die "--name requires a value"
                preset_name=$2
                shift 2
                ;;
            --*)
                die "unknown option: $1"
                ;;
            *)
                die "unexpected argument: $1"
                ;;
        esac
    done

    [ -n "$preset_key" ] || die "--key is required"
    if [ "$preset_key" = "-" ]; then
        IFS= read -r preset_key || preset_key=
    fi
    [ -n "$preset_key" ] || die "--key is required"

    case "$preset" in
        deepseek)
            [ -n "$preset_name" ] || preset_name=deepseek
            require_provider_name "$preset_name"
            cmd_set "$preset_name" \
                --base-url "https://api.deepseek.com/anthropic" \
                --key "$preset_key" \
                --use-auth-token \
                --model "deepseek-v4-pro[1m]" \
                --opus-model "deepseek-v4-pro[1m]" \
                --sonnet-model "deepseek-v4-pro[1m]" \
                --haiku-model "deepseek-v4-flash" \
                -e "CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash" \
                -e "CLAUDE_CODE_EFFORT_LEVEL=max"
            ;;
        openrouter)
            [ -n "$preset_name" ] || preset_name=openrouter
            require_provider_name "$preset_name"
            cmd_set "$preset_name" \
                --base-url "https://openrouter.ai/api" \
                --key "$preset_key" \
                --use-auth-token \
                --opus-model "~anthropic/claude-opus-latest" \
                --sonnet-model "~anthropic/claude-sonnet-latest" \
                --haiku-model "~anthropic/claude-haiku-latest" \
                -e "CLAUDE_CODE_SUBAGENT_MODEL=~anthropic/claude-opus-latest"
            ;;
        *)
            die "unknown preset: $preset"
            ;;
    esac
}

is_loopback_http_url() {
    case "$1" in
        http://*) ;;
        *) return 1 ;;
    esac

    authority=${1#http://}
    authority=${authority%%/*}
    case "$authority" in
        localhost|localhost:*) return 0 ;;
        \[::1\]|\[::1\]:*) return 0 ;;
        # IPv4-mapped IPv6 loopback, e.g. [::ffff:127.0.0.1]; the embedded
        # dotted address is range-checked by the 127.x.x.x branch below.
        \[::ffff:127.*\]|\[::ffff:127.*\]:*)
            mapped=${authority#\[::ffff:}
            host=${mapped%%\]*}
            ;;
        *)
            host=${authority%%:*}
            ;;
    esac

    case "$host" in
        127.[0-9]*.[0-9]*.[0-9]*)
            first=${host%%.*}
            rest=${host#*.}
            second=${rest%%.*}
            rest=${rest#*.}
            third=${rest%%.*}
            fourth=${rest#*.}
            case "$fourth" in
                *.*) return 1 ;;
            esac
            for octet in "$first" "$second" "$third" "$fourth"; do
                case "$octet" in
                    ''|*[!0-9]*) return 1 ;;
                esac
                case "$octet" in
                    [0-9]|[0-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]) ;;
                    *) return 1 ;;
                esac
            done
            return 0
            ;;
    esac
    return 1
}

verify_request() {
    base_url=$1
    key=$2
    model=$3
    auth=$4

    case "$base_url" in
        http://*|https://*) ;;
        *://*) printf 'unsupported scheme: %s\n' "${base_url%%://*}"; return 1 ;;
        *) printf 'invalid base_url: %s\n' "$base_url"; return 1 ;;
    esac
    command -v curl >/dev/null 2>&1 || die "curl is required for verify"

    (
        body_tmp=
        err_tmp=
        hdr_tmp=
        trap 'rm -f "$body_tmp" "$err_tmp" "$hdr_tmp"' EXIT
        trap 'exit 130' HUP INT TERM
        body_tmp=$(make_temp body) || exit 1
        err_tmp=$(make_temp curl) || exit 1
        hdr_tmp=$(make_temp hdr) || exit 1
        chmod_private_file "$hdr_tmp"
        if ! model_json=$(printf '%s' "$model" | json_quote) || [ -z "$model_json" ]; then
            printf 'failed to encode verify model name\n'
            exit 1
        fi
        body='{"model":"'"$model_json"'","max_tokens":1,"messages":[{"role":"user","content":"hi"}]}'
        url=${base_url%/}/v1/messages
        printf 'verifying against %s\n' "$url" >&2
        if [ "${base_url#http://}" != "$base_url" ] && ! is_loopback_http_url "$base_url"; then
            printf 'warning: sending provider secret over plain HTTP to %s\n' "$url" >&2
        fi
        if [ "$auth" = "$AUTH_TOKEN" ]; then
            hdr_prefix='Authorization: Bearer '
        else
            hdr_prefix='x-api-key: '
        fi
        {
            printf 'header = "%s' "$hdr_prefix"
            printf '%s' "$key" | curl_config_quote
            printf '"\n'
        } >"$hdr_tmp"
        status=$(curl -sS -m "$VERIFY_TIMEOUT" -o "$body_tmp" -w '%{http_code}' \
            -X POST "$url" \
            -H 'anthropic-version: 2023-06-01' \
            -H 'content-type: application/json' \
            --config "$hdr_tmp" \
            --data "$body" 2>"$err_tmp") || {
            msg=$(sed -n '1p' "$err_tmp")
            printf 'Connection failed: %s\n' "$msg"
            exit 1
        }

        case "$status" in
            2*) printf 'OK (%s)\n' "$status"; exit 0 ;;
            401) printf 'Authentication failed (401)\n'; exit 1 ;;
            403) printf 'Access denied (403)\n'; exit 1 ;;
            4*)
                etype=$(sed -n 's/.*"type"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$body_tmp" | sed -n '1p')
                emsg=$(sed -n 's/.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$body_tmp" | sed -n '1p')
                case " $FATAL_PROVIDER_ERROR_TYPES " in
                    *" $etype "*)
                        [ -n "$emsg" ] || emsg=$etype
                        printf 'Provider rejected: %s\n' "$emsg"
                        exit 1
                        ;;
                esac
                printf 'Reachable (HTTP %s)\n' "$status"
                exit 0
                ;;
            5*) printf 'Server error (HTTP %s)\n' "$status"; exit 1 ;;
            *) printf 'Connection failed: unexpected HTTP status %s\n' "$status"; exit 1 ;;
        esac
    )
}

probe_model() {
    provider_path=$1
    for model_key in \
        ANTHROPIC_MODEL \
        ANTHROPIC_DEFAULT_OPUS_MODEL \
        ANTHROPIC_DEFAULT_SONNET_MODEL \
        ANTHROPIC_DEFAULT_HAIKU_MODEL
    do
        model_value=$(conf_get "$provider_path" "$model_key")
        if [ -n "$model_value" ]; then
            printf '%s' "$model_value"
            return 0
        fi
    done
    printf '%s' "$VERIFY_PROBE_MODEL"
}

warn_shell_secret_conflict() {
    provider_name=$1
    auth=$2
    if [ "$auth" = "$AUTH_TOKEN" ]; then
        used_env=$ENV_AUTH_TOKEN
        other_env=$ENV_API_KEY
        [ "${ANTHROPIC_API_KEY+x}" = x ] || return 0
    else
        used_env=$ENV_API_KEY
        other_env=$ENV_AUTH_TOKEN
        [ "${ANTHROPIC_AUTH_TOKEN+x}" = x ] || return 0
    fi

    printf 'warning: current shell exports %s, but %s uses %s.\n' "$other_env" "$provider_name" "$used_env" >&2
    use_note "Same terminal cleanup: unset $other_env before starting Claude Code."
}

warn_preferred_auth_token() {
    provider_name=$1
    auth=$2
    base_url=$3
    if [ "$auth" = "$AUTH_API_KEY" ] && prefers_auth_token "$base_url"; then
        use_note "warning: DeepSeek Claude Code docs use ANTHROPIC_AUTH_TOKEN. Run: ccs set $provider_name --use-auth-token && ccs use $provider_name"
    fi
}

doctor_ok() {
    printf 'ok:   %s\n' "$1"
}

doctor_warn() {
    doctor_warn_count=$((doctor_warn_count + 1))
    printf 'warn: %s\n' "$1"
}

doctor_fail() {
    doctor_fail_count=$((doctor_fail_count + 1))
    printf 'fail: %s\n' "$1"
}

json_string() {
    printf '"'
    printf '%s' "$1" | json_quote
    printf '"'
}

# Resolve a project pin's raw (minified JSON) base-url and secret against the
# provider .conf files. Echoes the provider name; rc 1 when nothing matches.
# Matching on URL plus secret keeps same-endpoint/different-key providers
# distinct.
resolve_pin_name() {
    pin_url_raw=$1
    pin_secret_raw=$2
    for pin_file in "$PROVIDERS_DIR"/*.conf; do
        [ -e "$pin_file" ] || continue
        pin_name=$(basename "$pin_file" .conf)
        [ "$pin_name" != "$OFFICIAL_NAME" ] || continue
        [ "$(json_string "$(conf_get "$pin_file" ANTHROPIC_BASE_URL)")" = "$pin_url_raw" ] || continue
        [ "$(json_string "$(conf_get "$pin_file" key)")" = "$pin_secret_raw" ] || continue
        printf '%s' "$pin_name"
        return 0
    done
    return 1
}

# Summarize the cwd project pin for current/doctor. The pin has no marker
# file of its own: it is derived from the managed env keys actually present
# in .claude/settings.local.json, so there is no pointer to go stale.
# rc 1 when the file is absent or holds no managed keys.
project_pin_display() {
    pin_file_path=$PWD/$PROJECT_SETTINGS_REL
    [ -f "$pin_file_path" ] || return 1
    pin_managed=$(settings_parse managed "$pin_file_path") || return 1
    [ -n "$pin_managed" ] || return 1
    pin_url_raw=$(printf '%s\n' "$pin_managed" | awk -F '\t' '$1 == "ANTHROPIC_BASE_URL" { print $2; exit }')
    if [ "$pin_url_raw" = '""' ]; then
        # apply_official_project always blanks the base URL, so an explicit
        # "" means the subscription pin.
        printf '%s (claude.ai subscription pin)' "$OFFICIAL_NAME"
        return 0
    fi
    if [ -z "$pin_url_raw" ]; then
        printf '(partial pin: no ANTHROPIC_BASE_URL)'
        return 0
    fi
    pin_secret_raw=$(printf '%s\n' "$pin_managed" | awk -F '\t' '$1 == "ANTHROPIC_API_KEY" { print $2; exit }')
    if [ -z "$pin_secret_raw" ] || [ "$pin_secret_raw" = '""' ]; then
        pin_secret_raw=$(printf '%s\n' "$pin_managed" | awk -F '\t' '$1 == "ANTHROPIC_AUTH_TOKEN" { print $2; exit }')
    fi
    pin_url_display=$(printf '%s\n' "$pin_url_raw" | sed -e 's/^"//' -e 's/"$//')
    if pin_name=$(resolve_pin_name "$pin_url_raw" "$pin_secret_raw"); then
        printf '%s -> %s' "$pin_name" "$pin_url_display"
    else
        printf '(unregistered) -> %s' "$pin_url_display"
    fi
}

cmd_doctor() {
    [ "$#" -eq 0 ] || die "doctor does not accept arguments"

    doctor_warn_count=0
    doctor_fail_count=0

    printf 'ccs doctor %s\n' "$CCS_VERSION"

    if [ -d "$CCS_DIR" ]; then
        doctor_ok "config dir exists: $CCS_DIR"
    else
        doctor_warn "config dir is missing: $CCS_DIR (run: ccs init)"
    fi

    if [ -d "$PROVIDERS_DIR" ]; then
        provider_count=0
        for file in "$PROVIDERS_DIR"/*.conf; do
            [ -e "$file" ] || continue
            [ "$(basename "$file" .conf)" != "$OFFICIAL_NAME" ] || continue
            provider_count=$((provider_count + 1))
        done
        if [ "$provider_count" -gt 0 ]; then
            doctor_ok "providers configured: $provider_count"
        else
            doctor_warn "no providers configured yet (run: ccs set <name>)"
        fi
        if [ -f "$(provider_file "$OFFICIAL_NAME")" ]; then
            doctor_warn "providers/$OFFICIAL_NAME.conf exists but '$OFFICIAL_NAME' is built in; ccs ignores it (rename the file)"
        fi
    else
        doctor_warn "providers dir is missing: $PROVIDERS_DIR"
    fi

    if command -v claude >/dev/null 2>&1; then
        doctor_ok "claude command found"
    else
        doctor_warn "claude command not found in PATH"
    fi

    if command -v curl >/dev/null 2>&1; then
        doctor_ok "curl command found"
    else
        doctor_warn "curl command not found; ccs verify and default ccs use need curl"
    fi

    settings_dir=$(dirname "$SETTINGS_FILE")
    if [ -e "$SETTINGS_FILE" ]; then
        if [ -f "$SETTINGS_FILE" ]; then
            doctor_ok "settings file exists: $SETTINGS_FILE"
        else
            doctor_fail "settings path exists but is not a regular file: $SETTINGS_FILE"
        fi
        if [ -r "$SETTINGS_FILE" ]; then
            doctor_ok "settings file is readable"
        else
            doctor_fail "settings file is not readable: $SETTINGS_FILE"
        fi
        if [ -w "$SETTINGS_FILE" ]; then
            doctor_ok "settings file is writable"
        else
            doctor_warn "settings file is not writable: $SETTINGS_FILE"
        fi
        if grep -Eq '"ANTHROPIC_API_KEY"[[:space:]]*:' "$SETTINGS_FILE" 2>/dev/null &&
            grep -Eq '"ANTHROPIC_AUTH_TOKEN"[[:space:]]*:' "$SETTINGS_FILE" 2>/dev/null; then
            doctor_warn "settings file contains both ANTHROPIC_API_KEY and ANTHROPIC_AUTH_TOKEN"
        fi
    else
        if [ -d "$settings_dir" ]; then
            if [ -w "$settings_dir" ]; then
                doctor_ok "settings dir is writable: $settings_dir"
            else
                doctor_warn "settings dir is not writable: $settings_dir"
            fi
        else
            doctor_warn "settings file does not exist yet; ccs use will create it"
        fi
    fi

    active=$(active_name)
    if [ -z "$active" ]; then
        doctor_warn "no active provider selected (run: ccs use <name>)"
    elif [ "$active" = "$OFFICIAL_NAME" ]; then
        doctor_ok "active provider: $OFFICIAL_NAME (claude.ai subscription)"
        if [ -f "$SETTINGS_FILE" ] &&
            grep -Eq '"(ANTHROPIC_API_KEY|ANTHROPIC_AUTH_TOKEN|ANTHROPIC_BASE_URL)"[[:space:]]*:' "$SETTINGS_FILE" 2>/dev/null; then
            doctor_warn "settings file still contains provider env keys (re-run: ccs use $OFFICIAL_NAME)"
        fi
        if [ "${ANTHROPIC_API_KEY+x}" = x ]; then
            doctor_warn "current shell exports ANTHROPIC_API_KEY; it overrides the claude.ai login"
        fi
        if [ "${ANTHROPIC_AUTH_TOKEN+x}" = x ]; then
            doctor_warn "current shell exports ANTHROPIC_AUTH_TOKEN; it overrides the claude.ai login"
        fi
    else
        doctor_ok "active provider: $active"
        active_file=$(provider_file "$active")
        if [ -f "$active_file" ]; then
            auth=$(conf_get "$active_file" auth)
            [ -n "$auth" ] || auth=$AUTH_API_KEY
            key=$(conf_get "$active_file" key)
            base_url=$(conf_get "$active_file" ANTHROPIC_BASE_URL)
            if [ -n "$key" ]; then
                doctor_ok "active provider key is set: $(masked_key "$key")"
            else
                doctor_fail "active provider has empty key: $active"
            fi
            if [ -n "$base_url" ]; then
                case "$base_url" in
                    http://*|https://*) doctor_ok "active provider base URL: $base_url" ;;
                    *) doctor_fail "active provider base URL is not http(s): $base_url" ;;
                esac
            else
                doctor_fail "active provider is missing ANTHROPIC_BASE_URL: $active"
            fi
            if [ "$auth" = "$AUTH_TOKEN" ]; then
                doctor_ok "active provider secret env: $ENV_AUTH_TOKEN"
                if [ "${ANTHROPIC_API_KEY+x}" = x ]; then
                    doctor_warn "current shell exports ANTHROPIC_API_KEY but active provider uses ANTHROPIC_AUTH_TOKEN"
                fi
            else
                doctor_ok "active provider secret env: $ENV_API_KEY"
                if [ "${ANTHROPIC_AUTH_TOKEN+x}" = x ]; then
                    doctor_warn "current shell exports ANTHROPIC_AUTH_TOKEN but active provider uses ANTHROPIC_API_KEY"
                fi
                if prefers_auth_token "$base_url"; then
                    doctor_warn "DeepSeek Claude Code docs use ANTHROPIC_AUTH_TOKEN (run: ccs set $active --use-auth-token && ccs use $active)"
                fi
            fi
        else
            doctor_fail "active provider file is missing: $active_file"
        fi
    fi

    project_file=$PWD/$PROJECT_SETTINGS_REL
    if [ -f "$project_file" ]; then
        if pin_display=$(project_pin_display); then
            doctor_ok "project pin (cwd): $pin_display"
            if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1 &&
                ! git check-ignore -q -- "$PROJECT_SETTINGS_REL" 2>/dev/null; then
                # "[^"] means a non-empty secret value; blanked "" pins are safe.
                if grep -Eq '"(ANTHROPIC_API_KEY|ANTHROPIC_AUTH_TOKEN)"[[:space:]]*:[[:space:]]*"[^"]' "$project_file" 2>/dev/null; then
                    doctor_fail "$PROJECT_SETTINGS_REL holds a provider secret but is not git-ignored (fix: printf '%s\n' '$PROJECT_SETTINGS_REL' >> .gitignore)"
                else
                    doctor_warn "$PROJECT_SETTINGS_REL is not git-ignored"
                fi
            fi
            bleed=$({
                settings_parse managed "$project_file" | awk -F '\t' '{ print "P\t" $1 }'
                settings_parse managed "$GLOBAL_SETTINGS_FILE" | awk -F '\t' '{ print "G\t" $1 }'
            } | awk -F '\t' '
                $1 == "P" { p[$2] = 1 }
                $1 == "G" { g[$2] = 1 }
                END { for (k in g) if (!(k in p)) print k }
            ' | sort | tr '\n' ' ')
            bleed=${bleed% }
            if [ -n "$bleed" ]; then
                doctor_warn "global managed keys bleed into this project: $bleed (re-run: ccs use <name> --project)"
            fi
        else
            doctor_ok "project file present (cwd), no provider pin"
        fi
    fi

    if [ "$doctor_fail_count" -gt 0 ]; then
        printf 'summary: %s failure(s), %s warning(s)\n' "$doctor_fail_count" "$doctor_warn_count"
        return 1
    fi
    printf 'summary: 0 failure(s), %s warning(s)\n' "$doctor_warn_count"
}

print_shell_cleanup() {
    seen=' '
    for env_key in $MANAGED_ENV_KEYS; do
        case "$seen" in
            *" $env_key "*) continue ;;
        esac
        seen="$seen$env_key "
        printf 'unset %s\n' "$env_key"
    done
}

use_note() {
    if [ "${use_shell:-0}" -eq 1 ]; then
        printf '%s\n' "$1" >&2
    else
        printf '%s\n' "$1"
    fi
}

# Refuse to write a provider secret into a project file that git would
# commit. check-ignore covers .gitignore, .git/info/exclude, and the global
# excludesfile; outside a git work tree there is nothing to leak into.
project_secret_guard() {
    command -v git >/dev/null 2>&1 || {
        warn "git not found; cannot confirm $PROJECT_SETTINGS_REL is git-ignored"
        return 0
    }
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
    git check-ignore -q -- "$PROJECT_SETTINGS_REL" 2>/dev/null && return 0
    die "refusing to write a provider secret: $PROJECT_SETTINGS_REL is not git-ignored
  fix: printf '%s\n' '$PROJECT_SETTINGS_REL' >> .gitignore"
}

# `ccs use --global`: drop the project pin so the directory follows the
# global settings again. Only managed env keys are removed; everything else
# in the project file (permissions, hooks, non-managed env) stays.
use_project_global_reset() {
    if [ ! -f "$PWD/$PROJECT_SETTINGS_REL" ]; then
        use_note "no $PROJECT_SETTINGS_REL here; global settings already apply"
        return 0
    fi
    SETTINGS_FILE=$PWD/$PROJECT_SETTINGS_REL
    clear_provider_env
    reset_active=$(active_name)
    [ -n "$reset_active" ] || reset_active='(none)'
    use_note "project pin removed; this directory now follows the global settings (active: $reset_active)"
    if [ "$use_shell" -eq 1 ]; then
        print_shell_cleanup
        use_note "Current shell cleanup commands were printed to stdout."
    fi
    use_note "Restart Claude Code session to pick up the change."
}

# `ccs use official`: no .conf file and nothing to curl-verify -- the
# subscription credential is Claude Code's own OAuth login, which ccs never
# touches. Globally, removing the managed provider env from settings.json is
# what makes Claude Code fall back to it; in project mode the keys are
# blanked instead so the global values cannot bleed through the merge.
use_official() {
    if [ "${use_project:-0}" -eq 1 ]; then
        apply_official_project
        use_note "project pinned -> $OFFICIAL_NAME (claude.ai subscription)"
        use_note "file: $PROJECT_SETTINGS_REL"
        use_note "Run /login inside Claude Code if needed."
    else
        clear_provider_env
        if ! set_active "$OFFICIAL_NAME"; then
            warn "settings.json no longer pins a provider but the active marker could not be updated"
            warn "re-run: ccs use $OFFICIAL_NAME"
            exit 1
        fi
        use_note "switched -> $OFFICIAL_NAME (claude.ai subscription)"
        use_note "Managed provider env removed from settings.json; run /login inside Claude Code if needed."
    fi
    if [ "$use_shell" -eq 1 ]; then
        print_shell_cleanup
        use_note "Current shell cleanup commands were printed to stdout."
    else
        if [ "${ANTHROPIC_API_KEY+x}" = x ]; then
            warn "current shell exports ANTHROPIC_API_KEY; unset it or it will override the claude.ai login"
        fi
        if [ "${ANTHROPIC_AUTH_TOKEN+x}" = x ]; then
            warn "current shell exports ANTHROPIC_AUTH_TOKEN; unset it or it will override the claude.ai login"
        fi
        use_note "Restart Claude Code session to pick up the change."
    fi
}

cmd_use() {
    name=
    no_verify=0
    use_shell=0
    use_project=0
    use_global=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --no-verify) no_verify=1; shift ;;
            --shell) use_shell=1; shift ;;
            --project) use_project=1; shift ;;
            --global) use_global=1; shift ;;
            --*) die "unknown option: $1" ;;
            *)
                [ -z "$name" ] || die "unexpected argument: $1"
                name=$1
                shift
                ;;
        esac
    done
    if [ "$use_global" -eq 1 ]; then
        [ "$use_project" -eq 0 ] || die "--global and --project cannot be used together"
        [ -z "$name" ] || die "use --global takes no provider name; it removes the project pin"
        use_project_global_reset
        return 0
    fi
    [ -n "$name" ] || die "provider name is required"
    require_provider_name "$name"
    if [ "$use_project" -eq 1 ]; then
        SETTINGS_FILE=$PWD/$PROJECT_SETTINGS_REL
    fi
    if [ "$name" = "$OFFICIAL_NAME" ]; then
        [ ! -f "$(provider_file "$name")" ] || warn "ignoring providers/$OFFICIAL_NAME.conf: '$OFFICIAL_NAME' is built in"
        use_official
        return 0
    fi
    file=$(provider_file "$name")
    [ -f "$file" ] || die "no such provider: '$name'"
    auth=$(conf_get "$file" auth)
    [ -n "$auth" ] || auth=$AUTH_API_KEY
    key=$(conf_get "$file" key)
    base_url=$(conf_get "$file" ANTHROPIC_BASE_URL)
    model=$(probe_model "$file")

    # Check the gitignore guard before verify so a misconfigured project
    # fails fast without a network round-trip.
    if [ "$use_project" -eq 1 ]; then
        project_secret_guard
    fi

    if [ "$no_verify" -eq 0 ]; then
        msg=$(verify_request "$base_url" "$key" "$model" "$auth") || {
            use_note "verify failed: $msg"
            use_note "Use --no-verify to switch anyway."
            exit 1
        }
        use_note "verify: $msg"
    fi

    # settings.json is the source of truth Claude Code reads; the active file is
    # ccs's own bookkeeping. Write settings first so a failure here leaves the
    # old provider fully intact. If the active-pointer update then fails, the
    # new provider is already live, so surface the inconsistency loudly instead
    # of dying silently.
    apply_provider "$name"
    if [ "$use_project" -eq 1 ]; then
        # The project pin is per-directory state derived from the file itself;
        # the global active marker is deliberately left alone.
        use_note "project pinned -> $name"
        use_note "base_url: $base_url"
        use_note "file: $PROJECT_SETTINGS_REL"
    else
        if ! set_active "$name"; then
            warn "settings.json now uses '$name' but the active marker could not be updated"
            warn "re-run: ccs use $name"
            exit 1
        fi
        use_note "switched -> $name"
        use_note "base_url: $base_url"
    fi
    warn_preferred_auth_token "$name" "$auth" "$base_url"
    if [ "$use_shell" -eq 1 ]; then
        print_shell_cleanup
        use_note "Current shell cleanup commands were printed to stdout."
    else
        warn_shell_secret_conflict "$name" "$auth"
        use_note "Restart Claude Code session to pick up the new provider."
    fi
}

cmd_verify() {
    if [ "$#" -gt 1 ]; then
        die "too many arguments"
    fi
    name=${1:-$(active_name)}
    [ -n "$name" ] || die "no provider given and no active provider"
    require_provider_name "$name"
    if [ "$name" = "$OFFICIAL_NAME" ]; then
        die "'$OFFICIAL_NAME' uses the claude.ai subscription login; there is no provider endpoint to verify"
    fi
    file=$(provider_file "$name")
    [ -f "$file" ] || die "no such provider: '$name'"
    auth=$(conf_get "$file" auth)
    [ -n "$auth" ] || auth=$AUTH_API_KEY
    key=$(conf_get "$file" key)
    base_url=$(conf_get "$file" ANTHROPIC_BASE_URL)
    model=$(probe_model "$file")
    msg=$(verify_request "$base_url" "$key" "$model" "$auth") || {
        printf '%s: %s\n' "$name" "$msg"
        exit 1
    }
    printf '%s: %s\n' "$name" "$msg"
}

cmd_ls() {
    ensure_dirs
    active=$(active_name)

    official_url="(claude.ai subscription)"
    name_w=4
    secret_w=10
    url_w=8
    [ "${#OFFICIAL_NAME}" -gt "$name_w" ] && name_w=${#OFFICIAL_NAME}
    [ "${#official_url}" -gt "$url_w" ] && url_w=${#official_url}
    found=0
    for file in "$PROVIDERS_DIR"/*.conf; do
        [ -e "$file" ] || continue
        name=$(basename "$file" .conf)
        # The built-in pseudo provider shadows a same-named .conf; ls hides
        # the file so the table never shows two "official" rows (doctor
        # reports the conflict instead).
        [ "$name" = "$OFFICIAL_NAME" ] && continue
        found=1
        secret=$(secret_env_name "$(conf_get "$file" auth)")
        base_url=$(conf_get "$file" ANTHROPIC_BASE_URL)
        [ "${#name}" -gt "$name_w" ] && name_w=${#name}
        [ "${#secret}" -gt "$secret_w" ] && secret_w=${#secret}
        [ "${#base_url}" -gt "$url_w" ] && url_w=${#base_url}
    done

    printf '%-2s %-*s %-*s %-*s %s\n' "" "$name_w" "Name" "$secret_w" "Secret env" "$url_w" "Base URL" "Key"
    marker=
    [ "$OFFICIAL_NAME" = "$active" ] && marker='*'
    printf '%-2s %-*s %-*s %-*s %s\n' "$marker" "$name_w" "$OFFICIAL_NAME" "$secret_w" "-" "$url_w" "$official_url" "-"
    for file in "$PROVIDERS_DIR"/*.conf; do
        [ -e "$file" ] || continue
        name=$(basename "$file" .conf)
        [ "$name" = "$OFFICIAL_NAME" ] && continue
        marker=
        [ "$name" = "$active" ] && marker='*'
        auth=$(conf_get "$file" auth)
        key=$(conf_get "$file" key)
        base_url=$(conf_get "$file" ANTHROPIC_BASE_URL)
        printf '%-2s %-*s %-*s %-*s %s\n' "$marker" "$name_w" "$name" "$secret_w" "$(secret_env_name "$auth")" "$url_w" "$base_url" "$(masked_key "$key")"
    done
    if [ "$found" -eq 0 ]; then
        printf 'No custom providers yet. Try: ccs set <name>\n'
    fi
}

cmd_show() {
    [ "$#" -ge 1 ] || die "provider name is required"
    name=$1
    shift
    show_key=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --show-key) show_key=1; shift ;;
            *) die "unknown option: $1" ;;
        esac
    done
    require_provider_name "$name"
    if [ "$name" = "$OFFICIAL_NAME" ]; then
        printf '%-28s %s\n' name "$OFFICIAL_NAME"
        [ "$(active_name)" = "$OFFICIAL_NAME" ] && printf '%-28s yes\n' active || printf '%-28s no\n' active
        printf '%-28s %s\n' type "built-in (claude.ai subscription)"
        printf '%-28s %s\n' effect "removes managed provider env from settings.json"
        return 0
    fi
    file=$(provider_file "$name")
    [ -f "$file" ] || die "no such provider: '$name'"
    auth=$(conf_get "$file" auth)
    key=$(conf_get "$file" key)
    printf '%-28s %s\n' name "$name"
    [ "$(active_name)" = "$name" ] && printf '%-28s yes\n' active || printf '%-28s no\n' active
    printf '%-28s %s\n' "secret env" "$(secret_env_name "$auth")"
    if [ "$show_key" -eq 1 ]; then
        printf '%-28s %s\n' key "$key"
    else
        printf '%-28s %s\n' key "$(masked_key "$key")"
    fi
    provider_env_to_file "$file" /dev/stdout | while IFS= read -r line; do
        printf '%-28s %s\n' "${line%%=*}" "${line#*=}"
    done
}

cmd_current() {
    name=$(active_name)
    if [ -z "$name" ]; then
        global_line='No active provider'
    elif [ "$name" = "$OFFICIAL_NAME" ]; then
        global_line="$OFFICIAL_NAME -> claude.ai subscription"
    else
        file=$(provider_file "$name")
        [ -f "$file" ] || die "active provider '$name' is missing"
        global_line="$name -> $(conf_get "$file" ANTHROPIC_BASE_URL)"
    fi
    if pin_display=$(project_pin_display); then
        printf 'project: %s (%s)\n' "$pin_display" "$PROJECT_SETTINGS_REL"
        printf 'global:  %s\n' "$global_line"
    else
        printf '%s\n' "$global_line"
    fi
}

slim_usage() {
    cat <<'EOF'
Usage: ccs slim [--apply]

Report (default) or remove top-level keys in ./.claude/settings.local.json
that byte-for-byte duplicate the global settings. Claude Code merges scopes
per key, so a removed duplicate is simply inherited from the global file and
the effective configuration does not change; global edits then apply here
automatically. The env block is never touched.

Options:
  --apply    rewrite the project file (backs it up first; requires jq)
  --help     show this help
EOF
}

# `ccs slim`: the project file usually starts life as a hand copy of the
# global settings, so most non-env keys are byte-identical duplicates that
# shadow the global scope forever. A duplicate is an identical minified
# "key":value line in both scopes; different values or a different key order
# inside an object are conservatively kept.
cmd_slim() {
    apply=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --apply) apply=1; shift ;;
            --help) slim_usage; return 0 ;;
            *) die "unknown option: $1" ;;
        esac
    done
    project_file=$PWD/$PROJECT_SETTINGS_REL
    [ -f "$project_file" ] || die "no $PROJECT_SETTINGS_REL in the current directory"
    [ -f "$GLOBAL_SETTINGS_FILE" ] || die "global settings file not found: $GLOBAL_SETTINGS_FILE"
    if [ "$apply" -eq 1 ] && ! command -v jq >/dev/null 2>&1; then
        die "ccs slim --apply needs jq to rewrite the file faithfully; the report mode works without it"
    fi

    (
        proj_other=
        glob_other=
        slim_tmp=
        trap 'rm -f "$proj_other" "$glob_other" "$slim_tmp"' EXIT
        trap 'exit 130' HUP INT TERM
        proj_other=$(make_temp slim-proj) || exit 1
        glob_other=$(make_temp slim-glob) || exit 1
        settings_parse other "$project_file" >"$proj_other" || cannot_parse "$project_file"
        settings_parse other "$GLOBAL_SETTINGS_FILE" >"$glob_other" || cannot_parse "$GLOBAL_SETTINGS_FILE"

        # Duplicate keys are printed in their raw JSON-string form (quotes
        # kept) so the jq delete below loses nothing to re-escaping.
        # LC_ALL=C keeps match() byte-based and immune to invalid-UTF-8
        # aborts in BSD awk's multibyte regex path.
        dup_keys=$(LC_ALL=C awk '
            NR == FNR { g[$0] = 1; next }
            ($0 in g) && match($0, /^"([^"\\]|\\.)*"/) {
                print substr($0, 1, RLENGTH)
            }
        ' "$glob_other" "$proj_other") || die "cannot compare $project_file with the global settings"

        if [ -z "$dup_keys" ]; then
            printf 'nothing to slim: no top-level key duplicates the global settings\n'
            exit 0
        fi

        if [ "$apply" -eq 0 ]; then
            printf 'duplicates of the global settings (removed by --apply):\n'
            printf '%s\n' "$dup_keys" | sed -e 's/^"//' -e 's/"$//' -e 's/^/  /'
            printf 'run: ccs slim --apply\n'
            exit 0
        fi

        backups_dir=$CCS_DIR/backups
        mkdir -p "$backups_dir" || die "cannot create $backups_dir"
        chmod_private_dir "$backups_dir"
        backup_file=$backups_dir/slim-$(date +%Y%m%d-%H%M%S)-settings.local.json
        cp "$project_file" "$backup_file" || die "cannot back up $project_file"
        chmod_private_file "$backup_file"
        # Keep only the newest 10 slim backups so repeated --apply cannot grow
        # the backups dir without bound (mirrors backup_settings_file). The
        # timestamped names sort chronologically, so the oldest drop first.
        set -- "$backups_dir"/slim-*.json
        while [ "$#" -gt 10 ]; do
            rm -f "$1"
            shift
        done

        del_json=$(printf '%s\n' "$dup_keys" | awk '
            BEGIN { ORS = ""; print "[" }
            NR > 1 { print "," }
            { print }
            END { print "]" }
        ')
        slim_tmp=$(make_temp slim-out "$(dirname "$project_file")") || exit 1
        jq --argjson ccs_del "$del_json" 'delpaths($ccs_del | map([.]))' "$project_file" >"$slim_tmp" ||
            die "jq failed to rewrite $project_file (backup kept at $backup_file)"
        chmod_private_file "$slim_tmp"
        mv "$slim_tmp" "$project_file" || die "cannot write $project_file (backup kept at $backup_file)"

        printf 'removed %s duplicate key(s):\n' "$(printf '%s\n' "$dup_keys" | wc -l | tr -d ' ')"
        printf '%s\n' "$dup_keys" | sed -e 's/^"//' -e 's/"$//' -e 's/^/  /'
        printf 'these now inherit from the global settings\n'
        printf 'backup: %s\n' "$backup_file"
    ) || exit $?
}

cmd_rm() {
    [ "$#" -eq 1 ] || die "provider name is required"
    rm_name=$1
    require_provider_name "$rm_name"
    [ "$rm_name" != "$OFFICIAL_NAME" ] || die "'$OFFICIAL_NAME' is built in and cannot be removed"
    rm_file=$(provider_file "$rm_name")
    [ -f "$rm_file" ] || die "no such provider: '$rm_name'"
    if [ "$(active_name)" = "$rm_name" ]; then
        # Strip managed env from settings.json first (so Claude Code stops using
        # this provider), then clear the active marker. If clearing the marker
        # fails, the .conf is deliberately left in place so state stays
        # self-consistent and recoverable rather than half-removed.
        clear_provider_env
        if ! clear_active; then
            warn "settings.json was cleared but the active marker could not be updated"
            warn "re-run: ccs rm $rm_name"
            exit 1
        fi
    fi
    rm -f "$rm_file" || die "cannot remove provider file: $rm_file"
    printf 'removed %s\n' "$rm_name"
}

main() {
    cmd=${1:-ls}
    if [ "$#" -gt 0 ]; then
        shift
    fi
    case "$cmd" in
        init) cmd_init "$@" ;;
        set) cmd_set "$@" ;;
        preset) cmd_preset "$@" ;;
        use) cmd_use "$@" ;;
        slim) cmd_slim "$@" ;;
        verify) cmd_verify "$@" ;;
        doctor) cmd_doctor "$@" ;;
        ls|list) cmd_ls "$@" ;;
        current) cmd_current "$@" ;;
        show) cmd_show "$@" ;;
        rm|remove) cmd_rm "$@" ;;
        -h|--help|help) usage ;;
        -v|--version|version) printf 'ccs %s\n' "$CCS_VERSION" ;;
        *) die "unknown command: $cmd" ;;
    esac
}

main "$@"
